{{!
    @template block_categorycoursecards/course_cards

    Responsive grid of course cards.

    Example context (json):
    {
        "courses": [
            {
                "url": "/course/view.php?id=2",
                "imageurl": "/pluginfile.php/123/course/overviewfiles/course.jpg",
                "fullname": "Example course",
                "summary": "Example summary",
                "dimmed": false
            }
        ]
    }
}}
<div class="categorycoursecards-grid">
    {{#courses}}
        <article class="card categorycoursecards-card h-100{{#dimmed}} dimmed_text{{/dimmed}}">
            <a href="{{{url}}}" class="categorycoursecards-image-link">
                <span class="categorycoursecards-image-wrapper">
                    <img src="{{{imageurl}}}" alt="" class="categorycoursecards-image">
                </span>
            </a>
            <div class="card-body d-flex flex-column">
                <h3 class="h5 card-title mb-2">
                    <a href="{{{url}}}" class="aalink{{#dimmed}} dimmed{{/dimmed}}">{{{fullname}}}</a>
                </h3>
                {{#summary}}
                    <div class="card-text categorycoursecards-summary">{{{summary}}}</div>
                {{/summary}}
            </div>
        </article>
    {{/courses}}
</div>
